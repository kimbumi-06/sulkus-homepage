rules_version = '2';

// 운영진 판별: config/admins 문서의 emails 배열에 Google 계정 이메일이 있어야 함
// (config/admins 는 Firebase 콘솔에서 직접 만들고 고친다. 웹에서는 수정 불가)
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in
           get(/databases/$(database)/documents/config/admins).data.emails;
    }

    // 운영진 목록: 운영진만 읽기 (페이지가 운영진 여부를 확인하는 데 씀)
    match /config/admins {
      allow read: if isAdmin();
      allow write: if false;
    }

    // 게임별 수정 (한글 제목, 한글 설명)
    match /gameEdits/{gameId} {
      allow read, write: if isAdmin();
    }

    // 장르/메커니즘 사전 (한글 번역, 설명)
    match /terms/{termId} {
      allow read, write: if isAdmin();
    }

    // 동기화 진행 상태, AI 번역 캐시: 서버(Functions)만 씀
    match /sync/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /aiCache/{gameId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
